{
  "entities": {
    "users": {
      "title": "users",
      "description": "Registered application users logged in via Google Authentication",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar photo URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last login timestamp"
        }
      },
      "required": ["email"]
    },
    "audioGenerations": {
      "title": "audioGenerations",
      "description": "User generated voiceovers and Quran recitations",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user who owns this audio"
        },
        "title": {
          "type": "string",
          "description": "Title or snippet of the audio"
        },
        "text": {
          "type": "string",
          "description": "The script or Quran text recited"
        },
        "voiceName": {
          "type": "string",
          "description": "Name of the voice used"
        },
        "model": {
          "type": "string",
          "description": "Gemini TTS model used"
        },
        "audioBase64": {
          "type": "string",
          "description": "Base64 encoded audio WAV"
        },
        "mode": {
          "type": "string",
          "description": "single or dialogue"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp created"
        }
      },
      "required": ["userId", "text"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile document"
    },
    "/users/{userId}/audioHistory/{audioId}": {
      "schema": "audioGenerations",
      "description": "List of voice recordings generated by the user"
    }
  }
}
